{
  "manifest_version": 3,
  "name": "Analyse pixel",
  "description": "A tool to measure screen power consumption based on the displayed content.",
  "version": "0.2",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "models/models.js",
        "content/evaluate.js",
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ]
    }
  ]
}